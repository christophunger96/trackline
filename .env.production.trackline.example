# Trackline production env for Vercel/Netlify/Vite
# These values are safe for a Vite frontend only if they are public/publishable values.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_OR_PUBLISHABLE_KEY
VITE_SOCKET_URL=https://YOUR_RENDER_SOCKET_SERVER.onrender.com

# Optional; leave empty unless you use Discord embedded app setup.
VITE_DISCORD_CLIENT_ID=
